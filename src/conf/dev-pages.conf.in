        # ---- developer pages (disable: sudo <snap> dev-pages off)
        location ^~ /_hello/ {
            alias @SNAP@/www/hello/;
            index index.html;
            add_header Cache-Control "no-store" always;
        }

        location = /_hello/status {
            stub_status;
            access_log off;
        }

        location = /_hello/health {
            default_type text/plain;
            access_log off;
            return 200 "ok\n";
        }

        location = /_hello/config {
            alias @SNAP_DATA@/config.json;
            default_type application/json;
            add_header Cache-Control "no-store" always;
        }

        location = /_hello/request {
            default_type application/json;
            add_header Cache-Control "no-store" always;
            return 200 '{"method":"$request_method","uri":"$request_uri","args":"$args","protocol":"$server_protocol","scheme":"$scheme","host":"$host","server_addr":"$server_addr","server_port":"$server_port","remote_addr":"$remote_addr","remote_port":"$remote_port","user_agent":"$http_user_agent","accept":"$http_accept","accept_encoding":"$http_accept_encoding","accept_language":"$http_accept_language","referer":"$http_referer","x_forwarded_for":"$http_x_forwarded_for","request_id":"$request_id","time_iso8601":"$time_iso8601","nginx_version":"$nginx_version","hostname":"$hostname","pid":"$pid"}\n';
        }
