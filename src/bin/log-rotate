#!/bin/bash
# Timer (daily): rotate the nginx logs. Keeps $LOG_KEEP compressed copies
# next to each log (access.log.1.gz is the newest) and asks nginx to reopen
# its files. nginx keeps writing to the renamed file until it does, so the
# old file is compressed only afterwards. Empty logs are left alone.
set -e
. "$SNAP/lib/common.sh"
cd /   # see src/bin/cli

LOG_KEEP=14
rotated=()

for name in access error; do
    f="$LOG_DIR/$name.log"
    [ -s "$f" ] || continue
    for ((n = LOG_KEEP - 1; n >= 1; n--)); do
        [ -e "$f.$n.gz" ] && mv -f "$f.$n.gz" "$f.$((n + 1)).gz"
    done
    mv -f "$f" "$f.1"
    rotated+=("$f.1")
done
[ "${#rotated[@]}" -gt 0 ] || exit 0

if [ -s "$SNAP_DATA/run/nginx.pid" ]; then
    nginx_run -c "$NGINX_CONF" -s reopen || warn "could not ask nginx to reopen its logs"
    sleep 1
fi
gzip -f "${rotated[@]}"
echo "Rotated: ${rotated[*]}"
