#!/bin/bash
# Management CLI. Exposed as `<snap-name>` (the app is named after the snap).
set -e
. "$SNAP/lib/common.sh"

PROG="$SNAP_INSTANCE_NAME"

usage() {
    cat <<EOF
Usage: $PROG <command> [args]

Server control (need sudo):
  start                 Start the server and enable it at boot
  stop                  Stop the server and disable it at boot
  restart               Full restart of the server
  reload                Re-read configuration without dropping connections

Settings (need sudo):
  port <n>              Listen on port <n> (default $DEFAULT_PORT)
  autoindex on|off      Directory listings for folders without index.html
  dev-pages on|off      Developer pages under /_hello/ (default off)

Serve a git repository instead of the built-in site (need sudo):
  deploy <url> [--branch B] [--path P]
                        Fetch the repository and serve it (P: subfolder)
  update                Fetch again; deploy if the branch has new commits
  auto-update off|<n>m|<n>h
                        Run update periodically (default off)
  rollback              Serve the previous deploy (turns auto-update off)
  reset                 Back to the built-in site

Information:
  status                Service state, URL and what is being served
  config                Show the current settings
  check                 Request / and report the HTTP status
  test                  Validate the generated nginx configuration (sudo)
  logs [access|error] [-f] [-n N]
                        Show (or follow) the server logs (sudo)
  version               Show snap and nginx versions
  help                  Show this help

Settings can also be changed with:  sudo snap set $PROG port=80 dev-pages=true
                                    sudo snap set $PROG git.repo=https://...
EOF
}

url() {
    local port
    port=$(get_port)
    if [ "$port" = 80 ]; then echo "http://localhost/"; else echo "http://localhost:$port/"; fi
}

reload_if_running() {
    if service_active; then
        snapctl restart --reload "$SERVICE" || return 1
        echo "Server reloaded."
    else
        echo "Server is stopped; run 'sudo $PROG start' to apply."
    fi
}

# set_and_apply key value: persist a setting, roll back if nginx rejects it.
set_and_apply() {
    local key=$1 value=$2 old
    old=$(snapctl get "$key")
    snapctl set "$key=$value"
    if ! (apply_config) || ! reload_if_running; then
        if [ -n "$old" ]; then snapctl set "$key=$old"; else snapctl unset "$key"; fi
        (apply_config && reload_if_running) >/dev/null 2>&1 || true
        die "settings were not changed (details: $PROG logs error)"
    fi
}

# Apply a new web root; on failure go back to the previous deploy and die.
apply_site() { # previous-id
    if ! (apply_config) || ! reload_if_running; then
        git_restore "$1"
        (apply_config && reload_if_running) >/dev/null 2>&1 || true
        die "the site was not changed (details: $PROG logs error)"
    fi
}

set_or_unset() { # key value
    if [ -n "$2" ]; then snapctl set "$1=$2"; else snapctl unset "$1"; fi
}

cmd_deploy() {
    local repo= branch= path= prev old_repo old_branch old_path
    while [ $# -gt 0 ]; do
        case "$1" in
            --branch) shift; branch=${1:?--branch needs a name} ;;
            --branch=*) branch=${1#*=} ;;
            --path) shift; path=${1:?--path needs a folder} ;;
            --path=*) path=${1#*=} ;;
            -*) die "unknown deploy option '$1'" ;;
            *) [ -z "$repo" ] || die "usage: $PROG deploy <url> [--branch B] [--path P]"; repo=$1 ;;
        esac
        shift
    done
    [ -n "$repo" ] || die "usage: $PROG deploy <url> [--branch B] [--path P]"
    path=${path%/}
    validate_git_repo "$repo"
    validate_git_branch "$branch"
    validate_git_path "$path"

    old_repo=$(get_git_repo); old_branch=$(get_git_branch); old_path=$(get_git_path)
    prev=$(git_current)
    snapctl set git.repo="$repo"
    set_or_unset git.branch "$branch"
    set_or_unset git.path "$path"
    if ! (git_sync update) ||
       { [ "$(git_current)" != "$prev" ] && ! (apply_site "$prev"); }; then
        set_or_unset git.repo "$old_repo"
        set_or_unset git.branch "$old_branch"
        set_or_unset git.path "$old_path"
        die "nothing was deployed"
    fi
}

cmd_update() {
    local prev
    [ -n "$(get_git_repo)" ] || die "no repository configured (see: $PROG deploy)"
    prev=$(git_current)
    git_sync update
    [ "$(git_current)" = "$prev" ] || apply_site "$prev"
}

cmd_rollback() {
    local prev id
    prev=$(git_current)
    id=$(git_previous_id)
    [ -n "$id" ] || die "no earlier deploy to roll back to"
    git_set_current "$id"
    apply_site "$prev"
    # Keep the settings in line with what is served, so the configure hook
    # (refresh, snap set) does not redeploy.
    snapctl set git.repo="$(git_info "$id" repo)"
    set_or_unset git.branch "$(git_info "$id" branch)"
    set_or_unset git.path "$(git_info "$id" path)"
    echo "Serving ${id#*-} again (deployed $(git_info "$id" date))."
    if [ "$(get_git_autoupdate)" != off ]; then
        snapctl set git.auto-update=off
        echo "Auto-update turned off so it does not undo the rollback. Turn it back on with: $PROG auto-update <interval>"
    fi
}

cmd_reset() {
    local prev
    prev=$(git_current)
    [ -n "$prev" ] || [ -n "$(get_git_repo)" ] || { echo "Already serving the built-in site."; return 0; }
    snapctl unset git
    git_set_current ""
    apply_site "$prev"
    git_forget_all
    echo "Serving the built-in site."
}

on_off() { # name value -> true/false
    case "$2" in
        on|true|yes|1) echo true ;;
        off|false|no|0) echo false ;;
        *) die "$1 expects 'on' or 'off', got '${2:-}'" ;;
    esac
}

cmd_status() {
    local state id branch commit
    state=$(snapctl services "$SERVICE" | awk 'NR==2 {print $2 "/" $3}')
    echo "Service:   $SERVICE ($state)"
    echo "URL:       $(url)"
    id=$(git_current)
    if [ -n "$id" ]; then
        branch=$(git_info "$id" branch)
        echo "Serving:   $(git_info "$id" repo)${branch:+ ($branch)}"
        commit=$(git_info "$id" commit)
        echo "           commit ${commit:0:12}, deployed $(git_info "$id" date)"
        echo "           auto-update: $(get_git_autoupdate)"
    else
        echo "Serving:   built-in site $SITE_DIR  (version $SNAP_VERSION, revision $SNAP_REVISION)"
    fi
    if [ "$(get_devpages)" = true ]; then
        echo "Dev pages: $(url)_hello/"
    fi
    echo "Logs:      $LOG_DIR/"
}

cmd_config() {
    printf '%-16s %s\n' port "$(get_port)"
    printf '%-16s %s\n' autoindex "$(get_autoindex)"
    printf '%-16s %s\n' dev-pages "$(get_devpages)"
    if [ -n "$(get_git_repo)" ]; then
        printf '%-16s %s\n' git.repo "$(get_git_repo)" git.branch "$(get_git_branch)" \
            git.path "$(get_git_path)" git.auto-update "$(get_git_autoupdate)"
    fi
}

cmd_check() {
    local port status_line
    port=$(get_port)
    if ! { exec 3<>"/dev/tcp/127.0.0.1/$port"; } 2>/dev/null; then
        die "nothing is listening on port $port (try: $PROG status)"
    fi
    printf 'GET / HTTP/1.0\r\nHost: localhost\r\n\r\n' >&3
    status_line=$(head -n1 <&3 | tr -d '\r')
    exec 3<&-
    case "$status_line" in
        HTTP/*" 2"??" "*|HTTP/*" 3"??" "*) echo "OK: $(url) answered: $status_line" ;;
        HTTP/*) die "$(url) answered with an error: $status_line" ;;
        *) die "unexpected response: ${status_line:-<none>}" ;;
    esac
}

cmd_logs() {
    local which=access follow= lines=50 file
    while [ $# -gt 0 ]; do
        case "$1" in
            access|error) which=$1 ;;
            -f|--follow) follow=1 ;;
            -n) shift; lines=${1:?-n needs a number} ;;
            *) die "unknown logs option '$1'" ;;
        esac
        shift
    done
    file="$LOG_DIR/$which.log"
    [ -r "$file" ] || die "cannot read $file (try with sudo)"
    if [ -n "$follow" ]; then exec tail -n "$lines" -F "$file"; fi
    tail -n "$lines" "$file"
}

cmd=${1:-help}
[ $# -gt 0 ] && shift

case "$cmd" in
    start)
        require_root "$cmd"
        snapctl start --enable "$SERVICE"
        echo "Started. Serving on $(url)" ;;
    stop)
        require_root "$cmd"
        snapctl stop --disable "$SERVICE"
        echo "Stopped." ;;
    restart)
        require_root "$cmd"
        apply_config
        snapctl restart "$SERVICE"
        echo "Restarted. Serving on $(url)" ;;
    reload)
        require_root "$cmd"
        apply_config
        reload_if_running ;;
    port)
        require_root "$cmd"
        [ $# -eq 1 ] || die "usage: $PROG port <n>"
        validate_port "$1"
        validate_port_free "$1"
        set_and_apply port "$1"
        echo "Listening on $(url)" ;;
    autoindex)
        require_root "$cmd"
        set_and_apply autoindex "$(on_off autoindex "${1:-}")" ;;
    dev-pages)
        require_root "$cmd"
        set_and_apply dev-pages "$(on_off dev-pages "${1:-}")"
        [ "$(get_devpages)" = false ] || echo "Developer pages: $(url)_hello/" ;;
    deploy)   require_root "$cmd"; cmd_deploy "$@" ;;
    update)   require_root "$cmd"; cmd_update ;;
    rollback) require_root "$cmd"; cmd_rollback ;;
    reset)    require_root "$cmd"; cmd_reset ;;
    auto-update)
        require_root "$cmd"
        [ $# -eq 1 ] || die "usage: $PROG auto-update off|<n>m|<n>h"
        validate_git_autoupdate "$1"
        [ -n "$(get_git_repo)" ] || [ "$1" = off ] || die "no repository configured (see: $PROG deploy)"
        snapctl set git.auto-update="$1"
        echo "Auto-update: $1" ;;
    status)  cmd_status ;;
    config)  cmd_config ;;
    check)   cmd_check ;;
    test)
        require_root "$cmd"
        nginx_test "$NGINX_CONF" && echo "nginx configuration $NGINX_CONF is valid." ;;
    logs)    cmd_logs "$@" ;;
    version)
        echo "$PROG $SNAP_VERSION (revision $SNAP_REVISION)"
        "$SNAP/usr/sbin/nginx" -v 2>&1 ;;
    help|-h|--help) usage ;;
    *) usage >&2; exit 2 ;;
esac
